{
  "manifest_version": 3,
  "name": "Sleep Old Tabs",
  "version": "1.0",
  "description": "One click: unload every tab except the most recent ones.",
  "background": { "service_worker": "sw.js" },
  "action": { "default_title": "Sleep all but recent tabs" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" } }
  }
}
