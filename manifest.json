{
  "manifest_version": 3,
  "name": "Sleep Old Tabs",
  "version": "3.0",
  "description": "Unloads every tab except the most recent ones: on click, shortcut, or after 5 min of Dia being unused. Keeps a history.",
  "permissions": ["alarms", "idle", "nativeMessaging", "notifications", "processes", "storage", "system.memory", "tabs"],
  "background": { "service_worker": "sw.js" },
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "commands": {
    "sleep-tabs": { "description": "Sleep all but recent tabs", "suggested_key": { "default": "Alt+Shift+S" } }
  }
}
